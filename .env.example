# Copia questo file in `.env.local` per lo sviluppo, e imposta le stesse variabili
# su Vercel (Settings → Environment Variables).

# L'id del Google Sheet: sta nell'URL del foglio, tra /d/ e /edit
# https://docs.google.com/spreadsheets/d/QUESTO_PEZZO_QUI/edit
# Se non lo imposti, la webapp funziona lo stesso con i dati di esempio.
SHEET_ID=

# Parola segreta per forzare l'aggiornamento immediato dopo una modifica al foglio:
# apri /api/revalidate?secret=LA_TUA_PAROLA e i contenuti si ricaricano subito,
# senza aspettare i 10 minuti. Inventane una lunga e non condividerla.
REVALIDATE_SECRET=
